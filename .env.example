# LLM 配置模板 —— 复制为 .env 并填入真实密钥（.env 已在 .gitignore 中，不入库）
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 需求提取：单窗口最大字符数（对齐 deepseek-chat 4096 输出上限，窗口≤4000 字）
EXTRACT_WINDOW_CHARS=4000

# 服务端口（8000 被企业法律知识助手占用，本平台用 8001）
BIDGEN_PORT=8001

# ── M2：企业知识库 ──
# Milvus 向量库（本机 standalone v2.3.3；MILVUS_ENABLED=false 时纯 SQLite 暴力余弦降级）
MILVUS_URI=http://localhost:19530
MILVUS_ENABLED=true
# BGE 嵌入模型（本机已缓存 BAAI/bge-large-zh；bge|fake，fake 为离线测试伪嵌入）
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_DIM=1024
EMBEDDING_BACKEND=bge
# 知识库切块：单块最大字符数
KB_CHUNK_CHARS=600

# ── M7：企业级能力（认证 / RBAC / 审计）──
# JWT 签名密钥（生产必须改成随机长串）
JWT_SECRET=bidforge-dev-secret-change-me
# JWT 有效期（小时）
JWT_EXPIRE_HOURS=12
# 初始管理员（users 表为空时自动种子；生产请改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 鉴权开关（false = 无 token 放行为系统用户，仅旧版验收脚本/本机调试）
AUTH_ENABLED=true
